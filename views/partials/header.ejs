<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>MailSpace | ПЗ №1</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #f0f2f5; margin: 0; }
        .header { background: #2d343f; color: white; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; }
        .header a { color: #93b5f7; text-decoration: none; margin-left: 20px; font-weight: bold; }
        .container { max-width: 900px; margin: 30px auto; background: white; padding: 30px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
        .btn { padding: 10px 20px; background: #3498db; color: white; text-decoration: none; border: none; border-radius: 5px; cursor: pointer; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { padding: 12px; border-bottom: 1px solid #ddd; text-align: left; }
        .badge { background: #e8f0fe; color: #1a73e8; padding: 4px 8px; border-radius: 12px; font-size: 12px; }
        .error-msg { background: #fee; color: #c00; padding: 10px; border-radius: 5px; margin-bottom: 20px; }
    </style>
</head>
<body>
    <header class="header">
        <div>
            <strong>MailSpace</strong>
            <a href="/?auth=1">Главная</a>
            <a href="/add?auth=1">Добавить рассылку</a>
        </div>
        <div>👤 <%= user.name %></div>
    </header>
    <div class="container">